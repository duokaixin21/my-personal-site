---
import Layout from '../layouts/Layout.astro';
---

<Layout title="项目 · 多开心">
  <section class="px-6 md:px-12 pt-32 pb-16">
    <p class="cn-subtitle !text-left">PROJECTS</p>
    <h1 class="mt-6 font-display font-black leading-[0.9] tracking-tighter text-[3rem] md:text-[7rem] lg:text-[9rem]">
      项目<span class="text-[#a8322d]">.</span>
    </h1>
  </section>

  <div class="px-6 md:px-12">
    <div class="hairline-gradient"></div>
  </div>

  <section class="px-6 md:px-12 py-20 reveal">
    <!-- 主项目 -->
    <article class="bg-black border border-[#3a3a3a] p-10 md:p-14 relative overflow-hidden">
      <div class="text-xs text-[#a6a6a6] tracking-[0.3em] text-flow">01 · FEATURED · 2026</div>
      <h2 class="mt-6 font-display text-3xl md:text-5xl font-bold">
        问心之境
      </h2>
      <p class="mt-2 text-[#a8322d] tracking-widest text-sm">情绪数字孪生 · 新消费平台</p>

      <p class="mt-8 text-[#a6a6a6] leading-loose max-w-3xl">
        本项目为计算机学院 & 双创学院重点孵化项目——问心之境·情绪数字孪生新消费平台。
        聚焦青年情绪陪伴、智能文旅推荐赛道，融合多模态情绪识别、AI 数字孪生、
        情感计算、推荐系统等核心技术，可参与各类科创竞赛、申请软著、
        积累创新创业实践经历，资源齐全、指导到位、成长空间大。
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        <span class="px-3 py-1 border border-[#3a3a3a] text-xs text-[#a6a6a6] tracking-wide">多模态情绪识别</span>
        <span class="px-3 py-1 border border-[#3a3a3a] text-xs text-[#a6a6a6] tracking-wide">AI 数字孪生</span>
        <span class="px-3 py-1 border border-[#3a3a3a] text-xs text-[#a6a6a6] tracking-wide">情感计算</span>
        <span class="px-3 py-1 border border-[#3a3a3a] text-xs text-[#a6a6a6] tracking-wide">推荐系统</span>
      </div>
    </article>

    <!-- 占位卡 -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-px bg-[#3a3a3a] border border-[#3a3a3a]">
      <div class="bg-black p-10 group hover:bg-[#0a0a0a] transition-colors relative overflow-hidden sweep tilt">
        <div class="text-xs text-[#a6a6a6] tracking-[0.3em] text-flow">02 · 2026</div>
        <h3 class="mt-6 font-display text-2xl md:text-3xl font-normal">这个网站</h3>
        <p class="mt-4 text-[#a6a6a6] leading-relaxed">
          Astro + Tailwind  练习前端。
        </p>
      </div>
      <div class="bg-black p-10 group hover:bg-[#0a0a0a] transition-colors relative overflow-hidden sweep tilt opacity-60">
        <div class="text-xs text-[#a6a6a6] tracking-[0.3em] text-flow">03 · 等待新项目</div>
        <h3 class="mt-6 font-display text-2xl md:text-3xl font-normal">占位</h3>
        <p class="mt-4 text-[#a6a6a6] leading-relaxed">
          下一件要做的事。
        </p>
      </div>
    </div>
  </section>
</Layout>